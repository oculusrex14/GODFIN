{
  "name": "godfin-desktop",
  "productName": "GODFIN",
  "version": "0.1.0",
  "description": "Local-first personal finance for Indian banks",
  "author": "GODFIN",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev": "GODFIN_DEV_SERVER_URL=http://127.0.0.1:5200 electron .",
    "build:assets": "node scripts/build-assets.mjs",
    "dist": "npm run build:assets && electron-builder --publish never",
    "dist:mac": "npm run build:assets && electron-builder --mac --publish never",
    "dist:mac:local": "npm run build:assets && electron-builder --mac --publish never -c.mac.notarize=false -c.mac.identity=-",
    "dist:win": "npm run build:assets && electron-builder --win --publish never",
    "dist:linux": "npm run build:assets && electron-builder --linux --publish never",
    "verify:package": "node scripts/verify-package.mjs",
    "test:privacy": "node --test scripts/package-*.test.mjs",
    "test:update": "node --test ../packaging/update-feed.test.mjs ../packaging/release-provenance.test.mjs ../packaging/release-workflow-contract.test.mjs",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "png-to-ico": "^3.0.1"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "build": {
    "appId": "dev.godfin.desktop",
    "asar": true,
    "asarUnpack": [],
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend"
      },
      {
        "from": "../backend/dist/godfin-backend",
        "to": "backend/godfin-backend"
      },
      {
        "from": "../LICENSE",
        "to": "legal/LICENSE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../sbom/godfin.cdx.json",
        "to": "legal/godfin.cdx.json"
      },
      {
        "from": "../supply-chain/legal-clearance.json",
        "to": "legal/legal-clearance.json"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "artifactName": "GODFIN-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "generic",
      "url": "https://releases.godfin.dev"
    },
    "mac": {
      "category": "public.app-category.finance",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signtoolOptions": {
        "publisherName": "GODFIN"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office;Finance",
      "icon": "assets/icons"
    }
  }
}
