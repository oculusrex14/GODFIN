{
  "name": "godfin-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-entitlements.mjs",
    "dev": "next dev --turbopack -p 5300",
    "prebuild": "node scripts/sync-entitlements.mjs && node scripts/verify-production-contracts.mjs && node scripts/verify-supabase-migrations.mjs",
    "build": "next build",
    "start": "next start -p 5300",
    "lint": "next lint",
    "test:cashfree": "node --import tsx --test src/lib/cashfree.test.ts",
    "test:webhook": "node --import tsx --test src/lib/webhook-security.test.ts",
    "test:upgrades": "node --import tsx --test src/lib/license-upgrades.test.ts",
    "test:unit": "npm run test:cashfree && npm run test:webhook && npm run test:upgrades",
    "verify:contracts": "node scripts/sync-entitlements.mjs && node scripts/verify-production-contracts.mjs && node scripts/verify-supabase-migrations.mjs",
    "verify:migrations": "node scripts/verify-supabase-migrations.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "lucide-react": "1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.22.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.9.0",
    "eslint-config-next": "16.3.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  }
}
