{
  "name": "godfin-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-entitlements.mjs",
    "dev": "next dev --turbopack -p 5300",
    "prebuild": "node scripts/sync-entitlements.mjs && node scripts/verify-demo-fixture.mjs && node scripts/verify-production-contracts.mjs && node scripts/verify-supabase-migrations.mjs",
    "build": "next build",
    "start": "next start -p 5300",
    "lint": "next lint",
    "test:cashfree": "node --import tsx --test src/lib/cashfree.test.ts",
    "test:webhook": "node --import tsx --test src/lib/webhook-security.test.ts",
    "test:upgrades": "node --import tsx --test src/lib/license-upgrades.test.ts",
    "test:beta": "node --import tsx --test src/lib/beta.test.ts",
    "test:beta-checkout": "node --import tsx --test src/lib/beta-checkout.test.ts",
    "test:unit": "npm run test:cashfree && npm run test:webhook && npm run test:upgrades && npm run test:beta && npm run test:beta-checkout",
    "verify:demo": "node scripts/verify-demo-fixture.mjs",
    "verify:contracts": "node scripts/sync-entitlements.mjs && node scripts/verify-demo-fixture.mjs && node scripts/verify-production-contracts.mjs && node scripts/verify-supabase-migrations.mjs",
    "verify:migrations": "node scripts/verify-supabase-migrations.mjs",
    "beta:ops": "tsx scripts/beta-ops.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.9",
    "lucide-react": "0.468.0",
    "next": "15.5.22",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "resend": "6.18.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.22",
    "tsx": "4.23.12",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  }
}
